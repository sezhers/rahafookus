# See fail läheb kausta public/_redirects
# Cloudflare Pages loeb selle build'i ajal automaatselt ja rakendab
# määratud HTTP staatuskoodiga ümbersuunamisi (301 = püsiv).
#
# Formaat: VANA_TEE  UUS_TEE  STAATUSKOOD

# Vana postituste koondleht -> avaleht
/postitused/  /  301

# Vanad kategooriate URL-id (/kategooria/x/) -> uued (/x/)
/kategooria/investeerimine/         /investeerimine/          301
/kategooria/laenud-ja-krediit/      /laenud-ja-krediit/       301
/kategooria/nutikas-pangandus/      /nutikas-pangandus/       301
/kategooria/rahatarkus/             /rahatarkus/              301
/kategooria/saastmine-ja-eelarve/   /saastmine-ja-eelarve/    301
/kategooria/krypto/                 /krypto/                  301

# Esimese deploy'i katsetusest indekseerunud URL-id (/teemad/x/) -> uued (/x/)
/teemad/laenud-krediit/       /laenud-ja-krediit/       301
/teemad/pangandus/            /nutikas-pangandus/       301
/teemad/saastmine-eelarve/    /saastmine-ja-eelarve/    301
/teemad/investeerimine/       /investeerimine/          301
/teemad/kruptoraha/           /krypto/                  301
/teemad/rahatarkus/           /rahatarkus/              301

