---
// See fail asendab src/components/Footer.astro
// Sotsiaalmeedia lingid on eemaldatud.
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} {SITE_TITLE}. Veebilehe haldaja: Red Hornet OÜ.
	</p>
	<nav>
		<a href="/meist/">Meist</a>
	</nav>
</footer>

<style>
	footer {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: #666;
		border-top: 1px solid #eee;
	}
	footer nav a {
		color: inherit;
		text-decoration: none;
	}
	footer nav a:hover {
		text-decoration: underline;
	}
</style>
