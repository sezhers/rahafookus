---
// See fail asendab src/components/Header.astro
// Sotsiaalmeedia lingid on eemaldatud ning lisatud on "Kategooriad" dropdown-menüü.
import { SITE_TITLE, CATEGORIES } from "../consts";
---

<header>
	<nav>
		<div class="nav-left">
			<a href="/" class="site-title">{SITE_TITLE}</a>
		</div>
		<div class="nav-right">
			<a href="/">Avaleht</a>

			<details class="dropdown">
				<summary>Kategooriad</summary>
				<ul class="dropdown-menu">
					{
						CATEGORIES.map((category) => (
							<li>
								<a href={`/${category.slug}/`}>{category.name}</a>
							</li>
						))
					}
				</ul>
			</details>

			<a href="/postitused/">Postitused</a>
			<a href="/meist/">Meist</a>
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid #eee;
	}
	nav {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.site-title {
		font-weight: bold;
		font-size: 1.25rem;
		text-decoration: none;
		color: inherit;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		position: relative;
	}
	.nav-right > a {
		text-decoration: none;
		color: inherit;
	}
	.nav-right > a:hover {
		text-decoration: underline;
	}

	/* Dropdown */
	.dropdown {
		position: relative;
	}
	.dropdown summary {
		cursor: pointer;
		list-style: none;
	}
	.dropdown summary::-webkit-details-marker {
		display: none;
	}
	.dropdown summary::after {
		content: " ▾";
		font-size: 0.75rem;
	}
	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		margin: 0.5rem 0 0 0;
		padding: 0.5rem 0;
		list-style: none;
		background: white;
		border: 1px solid #ddd;
		border-radius: 6px;
		min-width: 220px;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
		z-index: 10;
	}
	.dropdown-menu li a {
		display: block;
		padding: 0.5rem 1rem;
		text-decoration: none;
		color: inherit;
		white-space: nowrap;
	}
	.dropdown-menu li a:hover {
		background: #f5f5f5;
	}
</style>
