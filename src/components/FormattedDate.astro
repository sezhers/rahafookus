---
// Standardse Astro "blog" template'i puhul see fail juba eksisteerib —
// sel juhul EI PEA seda üle kirjutama. Lisa see ainult siis, kui sul
// src/components/FormattedDate.astro veel puudub.
export interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString("et-EE", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	}
</time>
