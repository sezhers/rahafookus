---
// See fail asendab olemasoleva src/pages/index.astro
// Kohanda importide teed (BaseHead, Header, Footer) vastavalt oma projekti struktuurile,
// kui need erinevad standardsest Astro "blog" template'ist.
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from "../consts";

const latestPosts = (await getCollection("blog", (post) => post.data.pubDate <= new Date()))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="et">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Rahafookus — sinu fookus rahaasjadele</h1>
				<p>
					Rahafookus on rahale ja finantsidele keskendunud <strong>informatiivne ja hariduslik</strong>
					veebileht. Meie eesmärk on koguda ühte kohta kasulikku, arusaadavat ja usaldusväärset
					infot, mis aitab sul oma rahaasjades paremaid otsuseid teha — olgu tegu investeerimise,
					laenude, säästmise, panganduse või krüptovaluutadega.
				</p>
				<p>
					Uurime teemasid lihtsas ja selges keeles, ilma keerulise finantsžargoonita, et igaüks
					saaks vajaliku info kätte, sõltumata varasemast kogemusest.
				</p>
			</section>

			<section class="categories">
				<h2>Kategooriad</h2>
				<div class="category-grid">
					{
						CATEGORIES.map((category) => (
							<a class="category-card" href={`/${category.slug}/`}>
								<h3>{category.name}</h3>
								<p>{category.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="latest-posts">
				<h2>Viimased postitused</h2>
				<ul class="post-list">
					{
						latestPosts.map((post) => (
							<li>
								<a href={`/${post.data.category}/${post.id}/`}>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		max-width: 840px;
		margin: 0 auto 3rem auto;
		padding: 2rem 1rem 0 1rem;
		text-align: left;
	}
	.hero h1 {
		margin-bottom: 1rem;
	}
	.hero p {
		line-height: 1.6;
	}
	.categories {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem 3rem 1rem;
	}
	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		margin-top: 1.5rem;
	}
	.category-card {
		display: block;
		padding: 1.25rem;
		border: 1px solid #ddd;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.15s ease, transform 0.15s ease;
	}
	.category-card:hover {
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
		transform: translateY(-2px);
	}
	.category-card h3 {
		margin: 0 0 0.5rem 0;
	}
	.category-card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #555;
	}
	.latest-posts {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem 3rem 1rem;
	}
	.latest-posts .post-list {
		list-style: none;
		margin: 1.5rem 0 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
	}
	.latest-posts .post-list a {
		display: block;
		padding: 1.25rem;
		border: 1px solid #ddd;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.15s ease, transform 0.15s ease;
	}
	.latest-posts .post-list a:hover {
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
		transform: translateY(-2px);
	}
	.latest-posts .post-list h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1.15rem;
	}
	.latest-posts .post-list p {
		margin: 0 0 0.5rem 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #555;
	}
</style>
