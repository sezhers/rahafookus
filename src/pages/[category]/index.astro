---
// See fail läheb src/pages/[category]/index.astro
// Tulemus: rahafookus.ee/investeerimine/, rahafookus.ee/krypto/ jne.
// Iga leht kuvab kõik src/content/blog/ postitused, mille frontmatter'is
// on vastav "category" väärtus (vt src/content.config.ts).

import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { CATEGORIES, SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog", (post) => post.data.pubDate <= new Date());

	return CATEGORIES.map((category) => {
		const posts = allPosts
			.filter((post) => post.data.category === category.slug)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

		return {
			params: { category: category.slug },
			props: { category, posts },
		};
	});
}

const { category, posts } = Astro.props;
const title = category.seoTitle ?? `${category.name} | ${SITE_TITLE}`;
const description = category.metaDescription ?? category.description;
const intro = category.intro ?? category.description;
---

<!doctype html>
<html lang="et">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="category-page">
			<h1>{category.name}</h1>
			<p class="category-description">{intro}</p>

			{
				posts.length === 0 ? (
					<p class="empty">Selles kategoorias pole veel postitusi. Tule varsti tagasi!</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/${category.slug}/${post.id}/`}>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.category-page {
		max-width: 840px;
		margin: 0 auto;
		padding: 2rem 1rem 3rem 1rem;
	}
	.category-description {
		color: #555;
		margin-bottom: 2rem;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		margin-bottom: 1.5rem;
		border-bottom: 1px solid #eee;
		padding-bottom: 1.5rem;
	}
	.post-list a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-list h2 {
		margin: 0 0 0.4rem 0;
		font-size: 1.3rem;
	}
	.empty {
		color: #777;
	}
</style>
