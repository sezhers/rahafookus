---
// See fail läheb src/pages/meist/sergei.astro
// Tulemus: rahafookus.ee/meist/sergei/
import { Image } from "astro:assets";
import sergeiPhoto from "../../assets/sergei.jpg";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { AUTHORS, SITE_TITLE } from "../../consts";

const author = AUTHORS.find((a) => a.slug === "sergei")!;
const title = `${author.name} | ${SITE_TITLE}`;
const description = `${author.name} — ${author.role}. ${author.shortBio}`;

// TODO: täienda oma varasema töökogemusega
const experience = [
	{
		title: "99Bitcoins.com / Head of SEO",
		period: "2024–2025",
		description: "Kirjeldus: krüptovaluutad, gambling, finantsid. Vastutasin SEO strateegia ja sisu planeerimise eest.",
	},
	{
		title: "Serphead.com / Head of SEO & CEO",
		period: "2022-2024",
		description: "Kirjeldus: SEO agentuur, mis keskendus eelkõige rahvusvahelistele klientidele. Tiimi juhtimine, klientide haldamine, strateegia loomine ja elluviimine.",
	},
	{
		title: "Currency.com / Senior SEO Manager",
		period: "2021-2022",
		description: "Kirjeldus: Projekti krüptovaluutade poole SEO arendamine ja strateegia elluviimine.",
	},
];
---

<!doctype html>
<html lang="et">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="author-page">
			<Image src={sergeiPhoto} alt={author.name} width={200} height={200} class="profile-photo" />
			<h1>{author.name}</h1>
			<p class="role">{author.role}</p>

			<p>
				Tere, mina olen Sergei Ivanov. Olen ise investeerinud alates 2013. aastast erinevatesse
				varatüüpidesse — fondidesse, aktsiatesse, võlakirjadesse, ühisrahastusse ja ka
				krüptovaluutadesse. Nende aastate jooksul olen läbi teinud nii turgude tõuse kui languseid
				ning õppinud omal nahal, mis toimib ja mis mitte. Samuti olen teinud läbi mitmeid vigu, millest olen saanud väärtuslikke õppetunde.
			</p>

			<p>
				Rahafookus sündis soovist jagada seda kogemust edasi lihtsas ja arusaadavas keeles, ilma
				keerulise finantsžargoonita — nii nagu ma ise oleksin tahtnud investeerimisega alustades
				kelleltki kuulda.
			</p>

			<p>
				Olen Rahafookus.ee veebilehe omaniku <strong>Red Hornet OÜ</strong> juhatuse liige ja
				omanik. Samuti olen üks kogenumaid SEO spetsialiste Eestis, kellel on üle 10 aasta kogemust rahvusvaheliste projektide SEO arendamisel. Olen töötanud nii agentuurides kui ka ettevõtetes, juhtinud SEO meeskondi ja arendanud strateegiaid, mis on toonud märkimisväärseid tulemusi. Minu kogemus ulatub nii e-kaubanduse, finants- kui ka krüptovaluutade valdkonda, kus olen aidanud ettevõtetel saavutada paremat nähtavust otsingumootorites ja suurendada nii orgaanilist liiklust kui paremaid äritulemusi.
			</p>

			<section class="experience">
				<h2>Tähtsamad projektid</h2>
				<ul class="experience-list">
					{
						experience.map((job) => (
							<li class="experience-item">
								<div class="experience-header">
									<strong>{job.title}</strong>
									<span class="period">{job.period}</span>
								</div>
								<p>{job.description}</p>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.author-page {
		max-width: 840px;
		margin: 0 auto;
		padding: 2rem 1rem 3rem 1rem;
		line-height: 1.6;
	}
	.author-page h1 {
		margin-bottom: 0.25rem;
	}
	.role {
		color: #666;
		margin-top: 0;
		margin-bottom: 1.5rem;
		font-style: italic;
	}
	.profile-photo {
		display: block;
		width: 160px;
		height: 160px;
		object-fit: cover;
		border-radius: 50%;
		margin-bottom: 1.5rem;
	}
	.experience {
		margin-top: 2.5rem;
	}
	.experience-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.experience-item {
		padding: 1rem 0;
		border-top: 1px solid #e5e5e5;
	}
	.experience-header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.experience-header .period {
		color: #666;
		font-size: 0.9rem;
	}
</style>
